<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="intervalSettings" prefHeight="480" prefWidth="720" xmlns="http://javafx.com/javafx/" xmlns:fx="http://javafx.com/fxml/" fx:controller="io.github.scrvrdn.eartraining.controllers.IntervalSettingsController">
  <top>
    <HBox alignment="CENTER_RIGHT">
      <!-- <Button fx:id="backToMainMenuButton" onAction="#handleBackToMainMenuButton" text="Back to Main Menu" /> -->
      <Button fx:id="backToExerciseSectionButton" onAction="#handleBackToExerciseSectionButton" text="↩">
        <tooltip>
          <Tooltip text="Back to Exercise"/>
        </tooltip>
      </Button>
      <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
      </padding>
    </HBox>
  </top>
  <center>
    <VBox>
      <HBox alignment="TOP_CENTER" spacing="70.0">
          <fx:include fx:id="directions" source="directionspanel.fxml" />
          <fx:include fx:id="pitchRange" source="pitchrangepanel.fxml" />
          <fx:include fx:id="tempo" source="temposlider.fxml" />
        <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
      </HBox>
      <Separator />
      
      <fx:include fx:id="intervalTypePane" source="intervaltypesettingspanel.fxml" />
      
      <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding>
    </VBox>
  </center>
  <bottom>
    <HBox alignment="CENTER_RIGHT">
      <fx:include fx:id="presets" source="presets.fxml" />
      <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
      </HBox>
  </bottom>
</BorderPane>
