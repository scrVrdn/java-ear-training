<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="directions" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="io.github.scrvrdn.eartraining.controls.DirectionsPanel">
    <Label text="Interval Directions" />
    <CheckBox fx:id="ascendingCb" text="Ascending" onAction="#setDirection"/>
    <CheckBox fx:id="descendingCb" text="Descending" onAction="#setDirection"/>
    <CheckBox fx:id="simultaneousCb" text="Simultaneous" onAction="#setDirection"/>
</VBox>