<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>

<VBox fx:id="pitchRange" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="io.github.scrvrdn.eartraining.controls.PitchRangePanel">
    <Label text="Pitch Range">
        <padding>
            <Insets bottom="10"/>
        </padding>
    </Label>
    <HBox alignment="CENTER">
        <Label fx:id="maxPitchLabel" styleClass="pitch-label"/>
        <Spinner fx:id="maxPitchSpinner" styleClass="range-spinner"/>
    </HBox>
    <HBox alignment="CENTER">
        <Label fx:id="minPitchLabel" styleClass="pitch-label"/>
        <Spinner fx:id="minPitchSpinner" styleClass="range-spinner"/>
    </HBox>
</VBox>