<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="480" prefWidth="720" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="io.github.scrvrdn.eartraining.controllers.IntervalExerciseController">
    <top>
        <HBox>
            <Button fx:id="backToMainMenuButton" prefHeight="10" text="Back to Main Menu" onAction="#handleBackToMainMenuButton"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="goToSettingsButton" onAction="#handleGoToSettingsButton" text="☰">
                <tooltip>
                    <Tooltip text="Settings"/>
                </tooltip>
            </Button>
            <padding>
                <Insets left="5" right="5"/>
            </padding>
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER">
            <fx:include fx:id="answerButtons" source="intervalbuttonpanel.fxml" />
            
            <HBox alignment="CENTER" >
                <Button fx:id="replayIntervalButton" disable="true" mnemonicParsing="true" onAction="#handleReplayIntervalButton" text="_Replay" styleClass="standard-button"/>
                <Button fx:id="nextIntervalButton" disable="true" mnemonicParsing="true" onAction="#handleNextIntervalButton" text="_Next" styleClass="standard-button" />
                <padding>
                    <Insets top="40.0" />
                </padding>    
            </HBox>
            
            <Button fx:id="startButton" onAction="#handleStartButton" text="Start" styleClass="standard-button"/>
        </VBox>
    </center>
</BorderPane>
